{
	"distSpecVersion": "1.1.1",
	"storage": {
		"rootDirectory": "/tmp/zot"
	},
	"http": {
		"address": "127.0.0.1",
		"port": "8080"
	},
	"log": {
		"level": "debug"
	},
	"extensions": {
		"sync": {
			"enable": true,
			"registries": [
				{
					"urls": [
						"https://index.docker.io"
					],
					"onDemand": true,
					"tlsVerify": true,
					"maxRetries": 3,
					"retryDelay": "5m",
					"platforms": [
						"linux/amd64",
						"linux/arm64"
					],
					"content": [
						{
							"prefix": "library/**"
						}
					]
				},
				{
					"urls": [
						"https://registry.example.com"
					],
					"onDemand": false,
					"pollInterval": "6h",
					"tlsVerify": true,
					"platforms": [
						"linux/amd64"
					],
					"content": [
						{
							"prefix": "**"
						}
					]
				}
			]
		}
	}
}
